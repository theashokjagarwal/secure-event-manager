# ==============================================================================
# SECURE EVENT MANAGER - ENVIRONMENT CONFIGURATION
# ==============================================================================
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES:
#   cp .env.example .env
#
# SECURITY WARNING:
# Never commit .env to Git or expose this in public repositories!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=False
PORT=5050
HOST=127.0.0.1

# ------------------------------------------------------------------------------
# 2. JWT & SESSION SECURITY
# ------------------------------------------------------------------------------
# Generate a cryptographically strong random secret key for production:
# In python: import secrets; print(secrets.token_hex(32))
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
JWT_EXPIRATION_HOURS=2

# ------------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Supported DB_TYPE values: "sqlite" or "mysql"
# The backend uses an ORM (SQLAlchemy) abstraction layer, so changing this
# requires ZERO code changes in your routes or business logic!
DB_TYPE=sqlite

# If DB_TYPE=sqlite:
SQLITE_DB_PATH=events.db

# If DB_TYPE=mysql (uncomment and configure for MySQL):
# DB_HOST=localhost
# DB_PORT=3306
# DB_NAME=secure_events
# DB_USER=event_user
# DB_PASSWORD=your_strong_mysql_password

# ------------------------------------------------------------------------------
# 4. CORS & ORIGIN CONTROL
# ------------------------------------------------------------------------------
# In development, restrict access strictly to your frontend origin:
CORS_ORIGIN=http://127.0.0.1:5050

# ------------------------------------------------------------------------------
# 5. FILE UPLOAD SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Maximum file upload size in Megabytes (5MB is a good standard for documents/images)
MAX_CONTENT_LENGTH_MB=5
UPLOAD_FOLDER=app/uploads

# ------------------------------------------------------------------------------
# 6. RATE LIMITING (Brute-Force Attack Prevention)
# ------------------------------------------------------------------------------
# Allow at most 5 attempts per 60-second window for sensitive endpoints (login/register)
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=60
